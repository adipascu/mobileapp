<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Independently signed apps cannot declare the same custom permissions.
        PebbleKit 2 retains these unused declarations only for compatibility.
    -->
    <permission
        android:name="io.rebble.pebblekit2.permission.SEND_DATA_TO_WATCH"
        tools:node="remove" />
    <permission
        android:name="io.rebble.pebblekit2.permission.RECEIVE_DATA_FROM_WATCH"
        tools:node="remove" />
    <permission
        android:name="io.rebble.pebblekit2.permission.READ_PROVIDER"
        tools:node="remove" />
</manifest>
