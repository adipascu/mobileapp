<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission
        android:name="android.permission.health.WRITE_STEPS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.health.WRITE_HEART_RATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.health.WRITE_SLEEP"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.health.WRITE_EXERCISE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.health.WRITE_EXERCISE_ROUTE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.alarm.permission.SET_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="com.beeper.android.permission.READ_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="com.beeper.android.permission.SEND_PERMISSION"
        tools:node="remove" />

    <queries>
        <intent tools:node="remove">
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent tools:node="remove">
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <package
            android:name="com.beeper.android"
            tools:node="remove" />
    </queries>

    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter
                android:label="@string/intent_filter_notion_login"
                tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voiceapp" />
            </intent-filter>
            <intent-filter
                android:autoVerify="true"
                tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="cloud.repebble.com" />
                <data android:path="/githubAuth" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\.pbl" />
                <data android:pathPattern=".*\.pbw" />
                <data android:pathPattern=".*\.pbz" />
            </intent-filter>
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:mimeType="*/*"
                    android:scheme="content" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            tools:node="remove" />
        <activity
            android:name="com.viktormykhailiv.kmp.health.HealthConnectPermissionActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            tools:node="remove" />
        <activity-alias
            android:name="HealthPermissionsRationaleActivity"
            tools:node="remove" />
        <receiver
            android:name="coredevices.ring.glance.VoiceWidgetReceiver"
            tools:node="remove" />
        <receiver
            android:name="coredevices.ring.reminders.ReminderReceiver"
            tools:node="remove" />
        <receiver
            android:name="coredevices.ring.reminders.ReminderBootReceiver"
            tools:node="remove" />
        <service
            android:name="coredevices.ring.service.InferenceForegroundService"
            tools:node="remove" />
        <activity
            android:name="coredevices.ring.service.InferenceActivity"
            tools:ignore="Instantiatable"
            tools:node="remove" />
        <activity
            android:name="coredevices.ring.ShareToIndexNoteActivity"
            tools:ignore="Instantiatable"
            tools:node="remove" />
        <activity
            android:name="coredevices.ring.ShareToIndexReminderActivity"
            tools:ignore="Instantiatable"
            tools:node="remove" />
        <service
            android:name="coredevices.coreapp.BugReportService"
            android:foregroundServiceType="connectedDevice"
            tools:node="merge" />
        <service
            android:name="coredevices.coreapp.PebbleService"
            android:foregroundServiceType="connectedDevice"
            tools:node="merge" />
    </application>
</manifest>
